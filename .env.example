# -------------------------------------------------------------
# Food Recipe - Environment Configuration
# -------------------------------------------------------------

# Application
PORT=8000
ALLOWED_ORIGINS=*
CALLBACK_URL=http://localhost:8000/v1/payment/verify

# Hasura GraphQL Engine
# When running app locally against dockerized Hasura: http://localhost:8080/v1/graphql
# When running app inside docker-compose: http://hasura:8080/v1/graphql
HASURA_URL=http://localhost:8080/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=myadminsecretkey
HASURA_JWT_SECRET=my-super-secret-jwt-key-food-recipe-2026

# PostgreSQL (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=food_recipe
POSTGRES_PORT=5432

# Cloudinary (Media storage for avatar & recipe images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Chapa (Payment gateway for recipe checkout)
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
